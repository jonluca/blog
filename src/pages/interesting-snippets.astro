---
import { Content } from "../content/interesting-snippets.mdx";
import { mdxComponents } from "../components/mdx/components";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  path="/interesting-snippets"
  title="Interesting Snippets"
  description="A collection of interesting programming snippets by JonLuca DeCaro"
>
  <div class="text-page reading-column mb-8">
    <h1 class="clear-both mt-0 mb-2 text-2xl leading-tight font-semibold uppercase">Interesting Snippets</h1>
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
  </div>
</BaseLayout>
