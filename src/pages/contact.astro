---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout path="/contact" title="Contact" description="Contact JonLuca DeCaro">
  <div class="text-page reading-column mb-8">
    <h1 class="clear-both mt-0 mb-2 text-2xl leading-tight font-semibold uppercase">Contact</h1>
    <div class="prose">
      <p>
        You can email me at <a href="mailto:hello@jonlu.ca">hello@jonlu.ca</a>. You can also DM me on twitter at
        @jonluca.
      </p>
      <div class="mb-4">To get notified when I publish a new essay, please subscribe here:</div>
      <iframe
        title="Subscribe to JonLuca's Blog by email"
        src="https://jonluca.substack.com/embed"
        loading="lazy"
        width="100%"
        height="200"
        style="border: 0"
      ></iframe>
    </div>
  </div>
</BaseLayout>
