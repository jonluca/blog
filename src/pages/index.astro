---
import { getSortedBlogPosts } from "../../app/posts/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import { author, siteDescription, siteName, siteUrl } from "../lib/site";

const allPosts = getSortedBlogPosts();
const latest = allPosts[0];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: siteName,
      description: siteDescription,
      publisher: { "@id": `${author.url}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${author.url}/#person`,
      name: author.name,
      url: author.url,
    },
  ],
}).replaceAll("<", "\\u003c");
---

<BaseLayout path="/">
  <section>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <h1 class="sr-only">{siteName}</h1>
    <div class="text-page reading-column space-y-14">
      <section aria-labelledby="latest-post">
        <p class="mb-3 text-sm tracking-wider text-neutral-500 uppercase">Latest</p>
        <h2 id="latest-post" class="mb-2 text-2xl font-semibold">
          <a href={`/posts/${latest.slug}`}>{latest.metadata.title}</a>
        </h2>
        <time class="text-sm text-neutral-500" datetime={latest.metadata.date.toISOString()}>
          {latest.metadata.date.toLocaleString("en-US", { timeZone: "America/Los_Angeles", month: "short", day: "numeric", year: "numeric" })}
        </time>
        <p class="mt-4 max-w-[68ch] leading-relaxed text-black">{latest.metadata.description}</p>
      </section>

      <section aria-labelledby="archive">
        <h2 id="archive" class="mb-4 text-sm font-semibold tracking-wider text-neutral-500 uppercase">Archive</h2>
        <div class="flex flex-col">
          {
            allPosts.map((post) => (
              <a class="archive-row" href={`/posts/${post.slug}`}>
                <span class="text-[#244ebc]">{post.metadata.title}</span>
                <time class="text-sm text-[#737373] uppercase sm:text-right" datetime={post.metadata.date.toISOString()}>
                  {post.metadata.date.toLocaleString("en-US", {
                    timeZone: "America/Los_Angeles",
                    month: "short",
                    day: "numeric",
                    year: "numeric",
                  })}
                </time>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
