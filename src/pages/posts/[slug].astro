---
import { render } from "astro:content";
import Footer from "../../components/Footer.astro";
import { mdxComponents } from "../../components/mdx/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/post-metadata";
import { getAdjacentPosts, getSortedBlogPosts, type AdjacentPosts, type Post } from "../../lib/posts";
import { author, postUrl, siteName, siteUrl, socialImageUrl } from "../../lib/site";

interface Props {
  adjacent: AdjacentPosts;
  post: Post;
}

export async function getStaticPaths() {
  const posts = await getSortedBlogPosts();

  return posts.map((post) => {
    const adjacent = getAdjacentPosts(posts, post.id);

    return {
      params: { slug: post.id },
      props: { adjacent, post },
    };
  });
}

const { adjacent, post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = postUrl(post.id);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  description: post.data.description,
  image: socialImageUrl(post.data.image),
  url: canonicalUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  isPartOf: {
    "@type": "Blog",
    name: siteName,
    url: `${siteUrl}/`,
  },
  author: {
    "@type": "Person",
    name: author.name,
    url: author.url,
  },
  publisher: {
    "@type": "Person",
    name: author.name,
    url: author.url,
  },
}).replaceAll("<", "\\u003c");
---

<BaseLayout
  title={post.data.title}
  path={`/posts/${post.id}`}
  description={post.data.description}
  image={post.data.image}
  publishedTime={post.data.date}
>
  <section>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <header class="reading-column mb-10">
      <time class="text-sm text-neutral-600" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1 class="mt-2 mb-3 text-2xl font-semibold text-balance uppercase">{post.data.title}</h1>
      <p class="text-base leading-relaxed text-neutral-600">{post.data.description}</p>
    </header>

    <article class="prose text-black">
      <Content components={mdxComponents} />
    </article>

    <div class="reading-column">
      <Footer date={post.data.date} />
      {
        (adjacent.older || adjacent.newer) && (
          <nav class="post-neighbors" aria-label="Adjacent posts">
            {adjacent.older ? (
              <a href={`/posts/${adjacent.older.id}`}>
                <span>Older post</span>
                {adjacent.older.data.title}
              </a>
            ) : (
              <span />
            )}
            {adjacent.newer && (
              <a class="text-right" href={`/posts/${adjacent.newer.id}`}>
                <span>Newer post</span>
                {adjacent.newer.data.title}
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
