---
interface Props {
  file?: string;
  id: string;
}

const { file, id } = Astro.props;
const url = id.startsWith("http") ? new URL(id) : new URL(`${id.endsWith(".js") ? id : `${id}.js`}`, "https://gist.github.com/");
if (url.origin !== "https://gist.github.com" || !url.pathname.endsWith(".js")) {
  throw new Error("Gist embeds must use a gist.github.com JavaScript embed URL");
}
if (file) {
  url.searchParams.set("file", file);
}
const title = file ? `Embedded GitHub Gist: ${file}` : "Embedded GitHub Gist";
const embedId = `${id}-${file || ""}`.replaceAll(/[^a-zA-Z0-9_-]/g, "-");
---

<iframe
  title={title}
  data-gist-id={embedId}
  data-gist-src={url.toString()}
  loading="lazy"
  sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
  style="height: 100px; max-height: 600px; overflow: auto"
  width="100%"
  class="my-6 border-0"
></iframe>
<noscript><a href={url.toString()}>View {title}</a></noscript>

<script>
  const gistFrames = document.querySelectorAll<HTMLIFrameElement>("iframe[data-gist-src]:not([data-gist-ready])");

  const loadGist = (frame: HTMLIFrameElement) => {
    frame.dataset.gistReady = "true";
    const url = JSON.stringify(frame.dataset.gistSrc);
    const id = JSON.stringify(frame.dataset.gistId);
    frame.srcdoc = `<!doctype html>
<html>
  <head>
    <base target="_blank">
    <style>html,body{margin:0;padding:0;}*{font-size:12px;}</style>
  </head>
  <body>
    <script>
      (() => {
        const notify = () => parent.postMessage({
          type: "jonluca-gist-height",
          id: ${id},
          height: Math.ceil(document.documentElement.scrollHeight)
        }, "*");
        new ResizeObserver(notify).observe(document.documentElement);
        window.addEventListener("load", notify);
      })();
    <\/script>
    <script src=${url}><\/script>
  </body>
</html>`;
  };

  const gistWindow = window as Window & { gistResizeListenerInitialized?: boolean };
  if (!gistWindow.gistResizeListenerInitialized) {
    gistWindow.gistResizeListenerInitialized = true;
    window.addEventListener("message", (event) => {
      const data = event.data as { height?: unknown; id?: unknown; type?: unknown } | null;
      if (!data || data.type !== "jonluca-gist-height" || typeof data.id !== "string" || typeof data.height !== "number") {
        return;
      }
      const frame = document.querySelector<HTMLIFrameElement>(`iframe[data-gist-id="${CSS.escape(data.id)}"]`);
      if (frame?.contentWindow !== event.source || !Number.isFinite(data.height)) {
        return;
      }
      frame.style.height = `${Math.min(600, Math.max(100, Math.ceil(data.height)))}px`;
    });
  }

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);
            loadGist(entry.target as HTMLIFrameElement);
          }
        });
      },
      { rootMargin: "200px" },
    );
    gistFrames.forEach((frame) => observer.observe(frame));
  } else {
    gistFrames.forEach(loadGist);
  }
