<math display="block" aria-label="Two times the sum of integers from 1 to 360, divided by 720, equals 180.5">
  <mfrac>
    <mrow>
      <mn>2</mn>
      <mo>&times;</mo>
      <munderover>
        <mo>&sum;</mo>
        <mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow>
        <mn>360</mn>
      </munderover>
      <mi>n</mi>
    </mrow>
    <mn>720</mn>
  </mfrac>
  <mo>=</mo>
  <mn>180.5</mn>
</math>
