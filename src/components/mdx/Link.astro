---
interface Props {
  href?: string;
  [key: string]: unknown;
}

const { href = "", ...props } = Astro.props;
const external = !href.startsWith("/") && !href.startsWith("#") && !href.startsWith("mailto:");
---

<a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} {...props}><slot /></a>
