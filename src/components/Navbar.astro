---
const navItems = {
  "/": "Posts",
  "/about": "About",
  "/contact": "Contact",
  "/interesting-snippets": "Interesting Snippets",
};
---

<nav aria-label="Main" class="text-md border-b border-gray-200 py-8 text-center">
  {
    Object.entries(navItems).map(([path, name]) => (
      <a class="mx-2 text-[14px] text-[#244ebc] no-underline" href={path} title={name}>{name}</a>
    ))
  }
</nav>
