{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-05-24",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "jonlu.ca",
      "custom_domain": true,
    },
    {
      "pattern": "blog.jonlu.ca",
      "custom_domain": true,
    },
    {
      "pattern": "blog-dev.jonlu.ca",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
}
