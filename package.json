{
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc --noEmit",
    "knip": "knip",
    "test": "tsx --test src/lib/*.test.ts",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "start": "astro preview",
    "images:sync": "tsx scripts/generate-image-dimensions.ts",
    "upload:file": "tsx scripts/upload-asset.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.2",
    "astro": "^7.1.6",
    "autoprefixer": "^10.5.4",
    "chart.js": "4.5.1",
    "cssnano": "^8.0.2",
    "cytoscape": "^3.34.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.25",
    "postcss-import": "^16.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.5",
    "typescript": "6.0.3",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "knip": "^6.31.0"
  },
  "postcss": {
    "plugins": {
      "postcss-import": {},
      "@tailwindcss/postcss": {},
      "autoprefixer": {},
      "cssnano": {}
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
