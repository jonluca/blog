{
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc --noEmit",
    "knip": "knip",
    "test": "tsx --test src/lib/*.test.ts",
    "build": "astro build",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "start": "astro preview",
    "images:sync": "tsx scripts/generate-image-dimensions.ts",
    "upload:file": "tsx scripts/upload-asset.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.4.1",
    "astro": "^7.3.1",
    "autoprefixer": "^10.5.5",
    "chart.js": "4.5.1",
    "cssnano": "^9.0.2",
    "cytoscape": "^3.34.2",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.2",
    "glob": "^13.0.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "knip": "^6.34.0"
  },
  "postcss": {
    "plugins": {
      "postcss-import": {},
      "@tailwindcss/postcss": {},
      "autoprefixer": {},
      "cssnano": {}
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  }
}
